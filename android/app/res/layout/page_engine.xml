<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_engine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notice"
            android:padding="12dp"
            android:text="The frame-generation engine is bundled inside this APK. No-root mode captures the screen and composites generated frames in an overlay; you can also export the layer + profile for a Winlator/Bannerlator host."
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">

            <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NO-ROOT OVERLAY (BETA)" />

            <TextView
                android:id="@+id/overlay_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready — starts when you launch a game"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_overlay_now"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="START OVERLAY NOW" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Captures the screen with MediaProjection and composites generated frames in a full-screen overlay. No root required. The overlay is excluded from capture through SurfaceFlinger's skip-screenshot flag (Android 12+; Android 10–11 have no such API); if the OEM blocks that flag, the overlay refuses to start instead of recording itself. Overlay mode inserts one generated frame (2×). Adds roughly 50–80 ms of latency; secure/DRM apps show black; a display with refresh headroom is required to see extra frames. Stop it from the notification."
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CRASH REPORTS" />

            <TextView
                android:id="@+id/crash_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No crash reports"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_crash_report"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="SEND REPORT" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="A crash or a native renderer fault is saved with its trace, device, profile and the overlay session log. Sending opens a prefilled GitHub issue on the project tracker. With no crash saved, the button files the session log instead — that is what shows whether the capture or the renderer stalled."
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BUNDLED ENGINE" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp">
                <TextView android:layout_width="110dp" android:layout_height="wrap_content" android:text="Status" android:textColor="@color/muted" android:textSize="12sp" />
                <TextView android:id="@+id/engine_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Checking…" android:textColor="@color/text" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp">
                <TextView android:layout_width="110dp" android:layout_height="wrap_content" android:text="Version" android:textColor="@color/muted" android:textSize="12sp" />
                <TextView android:id="@+id/engine_version" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Win-FG v1.2" android:textColor="@color/text" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="8dp">
                <TextView android:layout_width="110dp" android:layout_height="wrap_content" android:text="Host layer" android:textColor="@color/muted" android:textSize="12sp" />
                <TextView android:id="@+id/engine_layer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="assets/win-fg/libwin_fg.so" android:textColor="@color/text" android:textSize="11sp" android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingBottom="12dp">
                <TextView android:layout_width="110dp" android:layout_height="wrap_content" android:text="Profile" android:textColor="@color/muted" android:textSize="12sp" />
                <TextView android:id="@+id/engine_profile" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="files/win-fg/conf.toml" android:textColor="@color/text" android:textSize="10sp" android:fontFamily="monospace" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UPDATE KEY" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Future versions must be signed with this certificate to install over v1.0. Keep this signing key for every update."
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/engine_sha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:text="SHA-256: …"
                android:textColor="@color/accent"
                android:textSize="9sp"
                android:textIsSelectable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="USE WITH A HOST" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pick a folder and the app writes libwin_fg.so, VkLayer_win_framegen.json and your conf.toml into win-fg/. Point a Winlator/Bannerlator container's Vulkan layer path at it and enable the layer with WIN_FG_ENABLE=1."
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_hostfolder"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="CHOOSE HOST FOLDER" />

            <TextView
                android:id="@+id/engine_hostpath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="No host folder selected"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <Button
                android:id="@+id/btn_export_conf"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="EXPORT PROFILE (.TOML)" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView style="@style/SectionLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UPDATES" />

            <TextView
                android:id="@+id/update_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You are on v1.2. Release builds keep the same update key, so newer APKs install straight over this one."
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_updates"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:text="OPEN RELEASES PAGE" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="18dp"
            android:text="Win-FG Native · clean-room frame generation. The no-root overlay captures the display and runs the bundled engine in the overlay; the host export is for Winlator/Bannerlator containers."
            android:textColor="@color/muted"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
