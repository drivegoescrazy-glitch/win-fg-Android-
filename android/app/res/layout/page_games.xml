<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_games"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/library_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_notice"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="●  PROFILE MODE  ·  settings are written on every launch"
        android:textColor="@color/muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="12dp">

        <EditText
            android:id="@+id/game_search"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:hint="Search games and apps"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="13sp"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:paddingLeft="14dp"
            android:paddingRight="14dp" />

        <Button
            android:id="@+id/game_refresh"
            style="@style/SecondaryButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginLeft="8dp"
            android:text="↻"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/games_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:text="SCANNING INSTALLED APPS…"
        android:textColor="@color/muted"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/game_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:listSelector="@android:color/transparent" />

        <TextView
            android:id="@+id/game_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="30dp"
            android:text="No launchable apps found"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
