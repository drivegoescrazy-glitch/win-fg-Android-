<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.winfg.launcher"
    android:versionCode="24"
    android:versionName="1.23"
    android:installLocation="auto">

    <!-- targetSdk stays current. Android 12/13 has no single-app MediaProjection,
         so the overlay excludes itself with SurfaceFlinger's skip-screenshot
         flag; the non-SDK lookup is exempted at runtime (see OverlayService).
         Android 14+ uses the public single-app MediaProjection path. -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <!-- versionCode 14: a second synthesis back end (occlusion-adaptive reprojection)
         selectable in Frame generation, and the generated frame is placed at the true
         temporal midpoint (alpha 0.5) instead of 0.35. versionCode 13: the capture no longer follows the overlay view's transient layout
         size, a watchdog rebuilds whichever side of the pipeline stopped, and the session
         log can be filed from the app. versionCode 12: the renderer no longer releases the AHardwareBuffer it was handed;
         that release stole a reference the Java Image/HardwareBuffer owns and killed the
         process later on the FinalizerDaemon. versionCode 11: crashes are collected into a deduplicated report queue and can be
         filed on the project's GitHub issue tracker from the app. versionCode 10 named the
         faulting module and offset plus the renderer stage, and restarted a session that
         crashed natively in capture-only mirror mode. -->

    <!-- No-root overlay mode: draw over games and capture the display with the
         user's MediaProjection consent. No root or system layer is required. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Needed to list launchable games on Android 11+. We never request
         QUERY_ALL_PACKAGES; only apps that expose a launcher activity match. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
